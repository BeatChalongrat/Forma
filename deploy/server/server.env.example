# Copy to deploy/server/generated/server.env ON THE SERVER and fill secrets.
# All paths here are relative to repo root (the first Compose file).
FORMA_ENV_FILE=deploy/server/generated/server.env
FORMA_SERVER_PROJECT=forma-production
FORMA_BIND_HOST=127.0.0.1
FORMA_WEB_PORT=8080
FORMA_S3_PORT=9000
FORMA_PUBLIC_URL=https://forma.example.com
FORMA_S3_PUBLIC_URL=https://files.forma.example.com
POSTGRES_USER=forma
POSTGRES_DB=forma
POSTGRES_PASSWORD=
MINIO_ROOT_USER=forma
MINIO_ROOT_PASSWORD=
FORMA_S3_BUCKET=forma-production
FORMA_AUTH=oidc
FORMA_AUTH_ALLOW_DEV_IN_PROD=false
FORMA_AUTH_ISSUER=
FORMA_AUTH_AUDIENCE=
FORMA_AUTH_CLIENT_ID=
FORMA_SECRET_KEY=
FORMA_KNOWLEDGE_POLICY=strict
# Connect the actual provider from Settings AFTER isolated deployment is verified.
FORMA_LLM_PROVIDER=mock
FORMA_LLM_MODEL=mock
FORMA_LLM_API_KEY=
FORMA_LLM_SHARED_RPM=60
FORMA_WORKERS=4
FORMA_WORKER_REPLICAS=2
