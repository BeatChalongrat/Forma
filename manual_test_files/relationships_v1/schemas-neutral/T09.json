{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "title": "Product delivery",
  "required": [
    "sku",
    "product_name",
    "sell_unit"
  ],
  "properties": {
    "sku": {
      "type": "string",
      "description": "Unique SKU identifier; preserve leading zeros.",
      "x-forma": {
        "semantic": "identity.sku"
      }
    },
    "product_name": {
      "type": "string",
      "description": "Product name from the master list.",
      "x-forma": {
        "semantic": "product.name"
      }
    },
    "sell_unit": {
      "type": "string",
      "description": "Full selling unit name. Codes require source evidence or human confirmation.",
      "x-forma": {
        "semantic": "unit.sell"
      }
    }
  },
  "x-forma": {
    "identity_keys": [
      "/sku"
    ]
  }
}