# FORMA production configuration — generated by `forma config example` from forma.core.settings.Settings.
# Every variable, its default and a one-line explanation. Copy to .env.production and fill in the
# secrets (marked SECRET). Do not edit by hand: `forma config example --check .env.production.example`
# runs in CI and fails when this file is out of date.

# dev | prod. prod requires migrations and disables create_all.
FORMA_ENV=dev

# Runtime data root (local storage, SQLite).
FORMA_DATA_DIR=../data

# SQLAlchemy URL. SQLite for dev; postgresql+psycopg://user:pass@host/db in production.  [SECRET]
FORMA_DATABASE_URL=

# Target JSON Schema dir.
FORMA_TARGET_SCHEMA_DIR=../target_schema

# approval.yaml / retention.yaml dir.
FORMA_POLICIES_DIR=../policies

# Migration scripts dir (auto: backend/alembic or ./alembic).
FORMA_ALEMBIC_DIR=

# mock | openai | openai_compatible | anthropic.
FORMA_LLM_PROVIDER=mock

# Model name sent to the provider.
FORMA_LLM_MODEL=gpt-4.1-mini

# Provider API key (secret).  [SECRET]
FORMA_LLM_API_KEY=

# Gateway base URL for openai_compatible.
FORMA_LLM_BASE_URL=

# Per-call HTTP timeout in seconds.
FORMA_LLM_TIMEOUT_S=90.0

# Structured-output retries on invalid JSON.
FORMA_LLM_MAX_RETRIES=2

# Attempts per provider call on timeouts/5xx.
FORMA_LLM_TRANSPORT_RETRIES=3

# Base backoff between transport retries (doubles).
FORMA_LLM_BACKOFF_S=1.0

# Consecutive provider failures that open the circuit.
FORMA_LLM_BREAKER_FAILURES=5

# Seconds the circuit stays open before a probe.
FORMA_LLM_BREAKER_RESET_S=120.0

# Max LLM-calling API requests per actor per minute.
FORMA_LLM_RATE_LIMIT_PER_MIN=30

# Max sample rows sent to a model per call.
FORMA_LLM_MAX_SAMPLE_ROWS=5

# Max characters per sample cell sent to a model.
FORMA_LLM_MAX_SAMPLE_CHARS=200

# Rows per engine chunk.
FORMA_CHUNK_ROWS=200000

# Sample rows kept per column profile.
FORMA_SAMPLE_ROWS=25

# Rows in Mapping Studio previews.
FORMA_PREVIEW_ROWS=200

# Fallback auto-approve threshold.
FORMA_AUTO_APPROVE_MIN_CONFIDENCE=0.95

# thread | process | arq (Redis-backed, `forma worker`).
FORMA_JOB_BACKEND=thread

# Worker threads/processes per node.
FORMA_WORKERS=4

# Files profiled concurrently inside one round.
FORMA_FILE_WORKERS=4

# Max queued+running jobs before the API answers 429.
FORMA_QUEUE_MAX=500

# A `running` job older than this is re-queued on start.
FORMA_JOB_STALE_S=1800

# Attempts before a stale job is marked failed.
FORMA_JOB_MAX_ATTEMPTS=3

# Redis URL for the arq backend (secret).  [SECRET]
FORMA_REDIS_URL=

# Largest accepted upload per file, in MB.
FORMA_MAX_UPLOAD_MB=200

# Hours between scheduled retention runs (0 = off).
FORMA_RETENTION_INTERVAL_H=0.0

# Scheduled retention deletes (true) or only plans (false).
FORMA_RETENTION_APPLY=False

# local | s3 (S3 or MinIO via boto3).
FORMA_STORAGE=local

# S3 bucket name.
FORMA_S3_BUCKET=forma

# Key prefix inside the bucket.
FORMA_S3_PREFIX=

# Custom endpoint (MinIO), empty for AWS.
FORMA_S3_ENDPOINT_URL=

# Endpoint browsers can reach, used only to pre-sign download URLs (MinIO).
FORMA_S3_PUBLIC_ENDPOINT_URL=

# S3 region.
FORMA_S3_REGION=us-east-1

# S3 access key id (falls back to AWS chain).
FORMA_S3_ACCESS_KEY=

# S3 secret key (secret).  [SECRET]
FORMA_S3_SECRET_KEY=

# Pre-signed download URL lifetime in seconds.
FORMA_S3_PRESIGN_S=900

# dev (X-Forma-User header, no verification) | oidc.
FORMA_AUTH=dev

# OIDC issuer URL (discovery at /.well-known).
FORMA_AUTH_ISSUER=

# Expected `aud` claim.
FORMA_AUTH_AUDIENCE=

# JWKS URL (derived from issuer when empty).
FORMA_AUTH_JWKS_URL=

# Public client id for the SPA (PKCE).
FORMA_AUTH_CLIENT_ID=

# Optional confidential client secret.  [SECRET]
FORMA_AUTH_CLIENT_SECRET=

# Token claim holding FORMA roles.
FORMA_AUTH_ROLE_CLAIM=roles

# Token claim restricting customers.
FORMA_AUTH_CUSTOMERS_CLAIM=customers

# Role for unknown users in dev mode.
FORMA_AUTH_DEV_DEFAULT_ROLE=admin

# OTLP gRPC/HTTP endpoint; unset = tracing off.
FORMA_OTEL_ENDPOINT=

# OpenTelemetry service.name.
FORMA_OTEL_SERVICE_NAME=forma-api

# console | json.
FORMA_LOG_FORMAT=console

# Python log level.
FORMA_LOG_LEVEL=INFO

# Allowed browser origins (JSON list).
FORMA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
