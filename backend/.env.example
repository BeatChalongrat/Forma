# Copy to backend/.env — all keys are optional; defaults run fully offline with SQLite.
FORMA_ENV=dev
FORMA_DATABASE_URL=sqlite:///../data/forma.db
# LLM: mock (offline) | openai | openai_compatible (any /v1/chat/completions gateway) | anthropic
FORMA_LLM_PROVIDER=mock
FORMA_LLM_MODEL=gpt-4.1-mini
FORMA_LLM_API_KEY=
FORMA_LLM_BASE_URL=
FORMA_AUTO_APPROVE_MIN_CONFIDENCE=0.95
